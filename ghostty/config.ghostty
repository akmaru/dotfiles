# Ghostty の設定。
# オプション一覧: `ghostty +show-config --default --docs` / https://ghostty.org/docs/config

# Font
font-family = HackGen Console NF
font-size = 13
font-thicken = true

# Theme
theme = Monokai Pro Spectrum

# Window
# iTerm2 の Transparency 0.13 に合わせる
background-opacity = 0.9

# Cursor
cursor-style = block
cursor-style-blink = false

# Keyboard
# iTerm2 の "Option Key Sends: Esc+" (左右とも) に相当。herdr の prefix+alt+f などの Alt 系キーに必要
macos-option-as-alt = true

# Shell integration
# 既定値に加えて ssh-env / ssh-terminfo を有効にする。リモートに xterm-ghostty の terminfo が
# 無いと TERM 不一致で vim / tmux の表示が崩れるため
shell-integration-features = ssh-env,ssh-terminfo

